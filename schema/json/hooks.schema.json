{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/JoBeGaming/schemas/refs/heads/main/schema/json/hooks.schema.json",
    "type": "object",
    "propertyNames": {
        "anyOf": [
            {
                "pattern": "^\\$[a-zA-Z]+$"
            },
            {
                "format": "uri-reference"
            }
        ]
    },
    "additionalProperties": {
        "type": "object",
        "properties": {
            "executable": {
                "type": "string",
                "format": "uri-reference"
            },
            "pyarguments": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "arguments": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "additionalProperties": false
    }
}
