{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "type": "object",
    "propertyNames": {
        "anyOf": [
            {
                "pattern": "^\\$[a-z]+"
            },
            {
                "format": "uri"
            }
        ]
    },
    "additionalProperties": {
        "type": "object",
        "properties": {
            "executable": {
                "type": "string",
                "format": "uri"
            },
            "pyarguments": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "arguments": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "additionalProperties": false
    }
}
