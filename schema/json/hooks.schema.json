{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/JoBeGaming/schemas/refs/heads/main/schema/json/hooks.schema.json",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string",
            "format": "uri-reference"
        },
        "$id": {
            "type": "string",
            "format": "uri"
        },
        "$comment": {
            "type": "string"
        }
    },
    "propertyNames": {
        "anyOf": [
            {
                "pattern": "^\\$[a-zA-Z]+$"
            },
            {
                "pattern": ""
            }
        ]
    },
    "additionalProperties": {
        "type": "object",
        "properties": {
            "executable": {
                "type": "string",
                "format": "uri-reference"
            },
            "pyarguments": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "arguments": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "id": {
                "type": "integer",
                "minimum": 0
            },
            "active": {
                "type": "boolean",
                "default": true
            },
            "phase": {
                "type": "string",
                "enum": [
                    "pre",
                    "prep",
                    "commit",
                    "post"
                ]
            }
        },
        "additionalProperties": false
    }
}
